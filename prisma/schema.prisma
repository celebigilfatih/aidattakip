generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  name              String
  phone             String?
  role              UserRole       @default(SECRETARY)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  trainerId         String?
  branchId          String?
  createdNotes      Note[]         @relation("NoteCreator")
  sentNotifications Notification[] @relation("NotificationSender")
  createdPayments   Payment[]      @relation("PaymentCreator")
  createdStudents   Student[]      @relation("StudentCreator")
  trainer           Trainer?       @relation(fields: [trainerId], references: [id])
  branch            Branch?        @relation("UserBranch", fields: [branchId], references: [id])
  markedAttendances Attendance[]   @relation("AttendanceMarker")
  createdExceptions TrainingException[] @relation("ExceptionCreator")
  groupPermissions  UserGroupPermission[]
  notificationRecipient NotificationRecipient? @relation("StaffRecipient")
  issuedPushInvites PushInvite[]
  summaryRules StaffSummaryRule[]
  assignedFollowUps FollowUp[]
  followUpActivities FollowUpActivity[]

  @@map("users")
}

model Student {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  birthDate      DateTime?
  groupId        String?
  isActive       Boolean        @default(true)
  enrollmentDate DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String
  branchId       String?
  attendances    Attendance[]
  groupHistories GroupHistory[]
  notes          Note[]
  notifications  Notification[]
  payments       Payment[]
  branch         Branch?        @relation(fields: [branchId], references: [id])
  createdBy      User           @relation("StudentCreator", fields: [createdById], references: [id])
  group          Group?         @relation(fields: [groupId], references: [id])
  parents        Parent[]       @relation("StudentParents")
  attendanceAnalytics AttendanceAnalytics[]
  notificationRecipient NotificationRecipient? @relation("StudentRecipient")
  familyId       String?
  family         Family? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  seasonEnrollments SeasonEnrollment[]
  convertedProspect Prospect?
  followUps FollowUp[]

  @@index([familyId])

  @@index([groupId, isActive])
  @@index([branchId, isActive])
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("students")
}

model Parent {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  email        String?
  address      String?
  relationship String
  isEmergency  Boolean   @default(false)
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  students     Student[] @relation("StudentParents")
  notificationRecipient NotificationRecipient? @relation("ParentRecipient")

  @@map("parents")
}

model Group {
  id                  String    @id @default(cuid())
  name                String    @unique // U10, U12, Başlangıç, İleri
  description         String?
  coachId             String?   // Ana antrenör
  assistantCoachId    String?   // Yardımcı antrenör
  branchId            String?   // Şube/Branch
  
  // Training Template Fields (NEW)
  trainingDays        String[]  @default([])     // ["Monday", "Wednesday", "Friday"]
  trainingStartTime   String?                    // "09:00"
  trainingEndTime     String?                    // "10:30"
  trainingType        String?                    // "Technical", "Tactical", "Conditioning", "Match Day", "Recovery"
  fieldId             String?
  
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  coach               Trainer?  @relation("GroupCoach", fields: [coachId], references: [id])
  assistantCoach      Trainer?  @relation("GroupAssistantCoach", fields: [assistantCoachId], references: [id])
  branch              Branch?   @relation(fields: [branchId], references: [id])
  field               Field?    @relation(fields: [fieldId], references: [id])
  
  students            Student[]
  feeTypes            FeeType[]
  trainings           Training[]
  trainingSessions    TrainingSession[]
  trainingExceptions  TrainingException[]
  groupHistories      GroupHistory[]
  userPermissions     UserGroupPermission[]
  seasonTargets       SeasonEnrollment[]
  prospects           Prospect[]
  
  @@map("groups")
}

model GroupHistory {
  id        String    @id @default(cuid())
  studentId String
  groupId   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  reason    String?
  createdAt DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])

  @@map("group_histories")
}

model FeeType {
  id        String    @id @default(cuid())
  name      String
  amount    Float
  period    FeePeriod @default(MONTHLY)
  groupId   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  group     Group?    @relation(fields: [groupId], references: [id])
  payments  Payment[]
  seasonEnrollments SeasonEnrollment[]

  @@map("fee_types")
}

model Payment {
  id              String         @id @default(cuid())
  studentId       String
  feeTypeId       String
  amount          Float
  dueDate         DateTime
  paidDate        DateTime?
  paidAmount      Float?
  paymentMethod   PaymentMethod?
  status          PaymentStatus  @default(PENDING)
  referenceNumber String?
  notes           String?
  receiptUrl      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String
  createdBy       User           @relation("PaymentCreator", fields: [createdById], references: [id])
  feeType         FeeType        @relation(fields: [feeTypeId], references: [id])
  student         Student        @relation(fields: [studentId], references: [id])

  seasonEnrollmentId String?
  seasonInstallment Int?
  seasonEnrollment SeasonEnrollment? @relation(fields: [seasonEnrollmentId], references: [id], onDelete: Restrict)

  @@unique([seasonEnrollmentId, seasonInstallment])

  @@index([studentId, status])
  @@index([dueDate, status])
  @@index([status])
  @@map("payments")
}

model Note {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  content     String
  type        NoteType @default(GENERAL)
  isPinned    Boolean  @default(false)
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("NoteCreator", fields: [createdById], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@map("notes")
}

model Training {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  group       Group    @relation(fields: [groupId], references: [id])
  
  @@map("trainings")
}

model TrainingSession {
  id                      String                  @id @default(cuid())
  groupId                 String
  date                    DateTime
  startTime               String
  endTime                 String
  fieldId                 String?
  locationId              String?
  status                  TrainingSessionStatus   @default(PLANNED)
  
  attendanceTaken         Boolean                 @default(false)
  attendanceTakenAt       DateTime?
  trialVisits             TrialVisit[]
  exceptionId             String?
  
  generatedAutomatically  Boolean                 @default(true)
  
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  
  // Relations
  group                   Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  field                   Field?                  @relation(fields: [fieldId], references: [id])
  location                Location?               @relation(fields: [locationId], references: [id])
  exception               TrainingException?      @relation(fields: [exceptionId], references: [id])
  attendances             Attendance[]
  
  @@index([groupId, date])
  @@index([date, status])
  @@map("training_sessions")
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  sessionId   String
  status      AttendanceStatus @default(PRESENT)
  
  markedBy    String?
  markedAt    DateTime?
  notes       String?
  excuseReason String?
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  // Relations
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  markedByUser User?           @relation("AttendanceMarker", fields: [markedBy], references: [id])
  
  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@map("attendances")
}

model Notification {
  id             String             @id @default(cuid())
  studentId      String?
  title          String
  message        String
  type           NotificationType
  method         NotificationMethod
  status         NotificationStatus @default(PENDING)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientEmail String?
  recipientPhone String?
  recipientId    String?
  targetDeviceId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdById    String
  createdBy      User               @relation("NotificationSender", fields: [createdById], references: [id])
  student        Student?           @relation(fields: [studentId], references: [id])
  recipient      NotificationRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  targetDevice   PushDevice? @relation(fields: [targetDeviceId], references: [id], onDelete: SetNull)
  deliveries     PushDelivery[]
  isFeeSummary Boolean @default(false)
  summaryBranchId String?
  summaryRunId String?
  summaryRun StaffSummaryRun? @relation(fields: [summaryRunId], references: [id], onDelete: Restrict)
  @@unique([summaryRunId, recipientId])

  @@index([method, status, createdAt])
  @@index([createdAt])
  @@index([studentId])
  @@map("notifications")
}

model Trainer {
  id                String   @id @default(cuid())
  name              String
  position          String
  experience        Int
  license           String?
  photo             String?
  biography         String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  groupsAsAssistant Group[]  @relation("GroupAssistantCoach")
  groupsAsCoach     Group[]  @relation("GroupCoach")
  user              User[]

  @@map("trainers")
}

model Branch {
  id          String    @id @default(cuid())
  name        String    @unique
  address     String?
  phone       String?
  email       String?
  managerName String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  groups      Group[]
  students    Student[]
  fields      Field[]
  locations   Location[]
  users       User[]    @relation("UserBranch")
  families    Family[]
  prospects   Prospect[]
  attentionPolicy AttentionPolicy?
  
  @@map("branches")
}

model UserGroupPermission {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_group_permissions")
}

// NEW: TrainingException model
model TrainingException {
  id                String        @id @default(cuid())
  groupId           String
  date              DateTime
  
  type              ExceptionType
  
  newStartTime      String?  // Only for TIME_CHANGE
  newEndTime        String?  // Only for TIME_CHANGE
  newFieldId        String?  // Only for FIELD_CHANGE
  newLocationId     String?  // Only for LOCATION_CHANGE
  
  reason            String?  // "Weather", "Coach sick", "Facility unavailable", etc.
  createdBy         String   // User ID
  
  createdAt         DateTime      @default(now())
  
  // Relations
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  field             Field?        @relation(fields: [newFieldId], references: [id])
  location          Location?     @relation(fields: [newLocationId], references: [id])
  createdByUser     User          @relation("ExceptionCreator", fields: [createdBy], references: [id])
  sessions          TrainingSession[]
  
  @@unique([groupId, date]) // Only one exception per day per group
  @@map("training_exceptions")
}

// NEW: Field model
model Field {
  id        String    @id @default(cuid())
  branchId  String?
  name      String
  capacity  Int?
  location  String?  // GPS coordinates or address
  isActive  Boolean   @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  branch              Branch?             @relation(fields: [branchId], references: [id])
  trainingSessions    TrainingSession[]
  trainingExceptions  TrainingException[]
  groups              Group[]
  
  @@map("fields")
}

// NEW: Location model
model Location {
  id        String    @id @default(cuid())
  branchId  String?
  name      String
  address   String?
  city      String?
  district  String?
  phone     String?
  isActive  Boolean   @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  branch              Branch?             @relation(fields: [branchId], references: [id])
  trainingSessions    TrainingSession[]
  trainingExceptions  TrainingException[]
  
  @@map("locations")
}

// NEW: AttendanceAnalytics model
model AttendanceAnalytics {
  id                    String  @id @default(cuid())
  studentId             String
  month                 Int     // 1-12
  year                  Int     // 2026
  
  totalSessions         Int     @default(0)
  presentCount          Int     @default(0)
  absentCount           Int     @default(0)
  lateCount             Int     @default(0)
  excusedCount          Int     @default(0)
  attendancePercentage  Float   @default(0)
  
  consecutiveAbsences   Int     @default(0)
  hasWarning            Boolean @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  student               Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, month, year])
  @@map("attendance_analytics")
}

enum UserRole {
  ADMIN
  ACCOUNTING
  TRAINER
  SECRETARY
}

enum TrainingSessionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum ExceptionType {
  CANCELLED
  TIME_CHANGE
  FIELD_CHANGE
  LOCATION_CHANGE
  EXTRA_SESSION
}

enum FeePeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
  SEMI_ANNUAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum NoteType {
  GENERAL
  HEALTH
  BEHAVIOR
  PAYMENT
  ACADEMIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum NotificationType {
  PAYMENT_REMINDER
  PAYMENT_OVERDUE
  ATTENDANCE_REMINDER
  GENERAL_ANNOUNCEMENT
  TRAINING_CANCELLED
}

enum NotificationMethod {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
  PROCESSING
  ACCEPTED
}

enum RecipientKind {
  STAFF
  PARENT
  STUDENT
}

model NotificationRecipient {
  id String @id @default(cuid())
  kind RecipientKind
  staffPushEnabled Boolean @default(false)
  primaryDeviceId String? @unique
  primaryDevice PushDevice? @relation("PrimaryPushDevice", fields: [primaryDeviceId], references: [id], onDelete: SetNull)
  summaryRules StaffSummaryRecipient[]
  userId String? @unique
  parentId String? @unique
  studentId String? @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  user User? @relation("StaffRecipient", fields: [userId], references: [id], onDelete: Cascade)
  parent Parent? @relation("ParentRecipient", fields: [parentId], references: [id], onDelete: Cascade)
  student Student? @relation("StudentRecipient", fields: [studentId], references: [id], onDelete: Cascade)
  invites PushInvite[]
  sessions RecipientSession[]
  devices PushDevice[]
  notifications Notification[]
  @@map("notification_recipients")
}

model PushInvite {
  id String @id @default(cuid())
  tokenHash String @unique
  recipientId String
  createdById String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
  @@map("push_invites")
}

model RecipientSession {
  id String @id @default(cuid())
  tokenHash String @unique
  recipientId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId])
  @@map("recipient_sessions")
}

model PushDevice {
  id String @id @default(cuid())
  recipientId String
  sessionHash String
  expiresAt DateTime
  endpoint String @unique
  p256dh String
  auth String
  label String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]
  primaryFor NotificationRecipient? @relation("PrimaryPushDevice")
  deliveries PushDelivery[]
  @@index([recipientId, isActive])
  @@index([sessionHash])
  @@map("push_devices")
}

model PushDelivery {
  id String @id @default(cuid())
  notificationId String
  deviceId String
  status String @default("PROCESSING")
  statusCode Int?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([notificationId, deviceId])
  @@map("push_deliveries")
}

model SystemSetting {
  id                 String   @id @default(cuid())
  schoolName         String   @default("Futbol Okulu")
  schoolAddress      String   @default("İstanbul, Türkiye")
  schoolPhone        String   @default("+90 212 555 0000")
  schoolEmail        String   @default("info@futbolokulu.com")
  schoolLogo         String?
  currency           String   @default("TRY")
  timeZone           String   @default("Europe/Istanbul")
  language           String   @default("tr")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  autoBackup         Boolean  @default(true)
  backupFrequency    String   @default("daily")
  sessionTimeout     Int      @default(24)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("system_settings")
}

model StaffSummaryRule {
  id String @id @default(cuid())
  archivedAt DateTime?
  name String
  weekdays Int[]
  time String @default("09:00")
  enabled Boolean @default(false)
  branchId String?
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lastEvaluatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients StaffSummaryRecipient[]
  runs StaffSummaryRun[]
  @@map("staff_summary_rules")
}
model StaffSummaryRecipient {
  ruleId String
  recipientId String
  rule StaffSummaryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@id([ruleId, recipientId])
  @@map("staff_summary_recipients")
}
model StaffSummaryRun {
  id String @id @default(cuid())
  ruleId String
  scheduledAt DateTime
  kind String @default("AUTOMATIC")
  status String @default("PROCESSING")
  accepted Int @default(0)
  failed Int @default(0)
  skipped Int @default(0)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  rule StaffSummaryRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  notifications Notification[]
  @@unique([ruleId, scheduledAt])
  @@index([createdAt])
  @@map("staff_summary_runs")
}

model Family {
  id String @id @default(cuid())
  name String
  branchId String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students Student[]
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, archivedAt])
  @@map("families")
}

model Season {
  id String @id @default(cuid())
  name String
  startDate DateTime
  endDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollments SeasonEnrollment[]
  @@map("seasons")
}

model SeasonEnrollment {
  id String @id @default(cuid())
  seasonId String
  studentId String
  decision RenewalDecision @default(UNDECIDED)
  targetGroupId String?
  feeTypeId String?
  plannedAmount Float?
  firstDueDate DateTime?
  approvedAt DateTime?
  activatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  targetGroup Group? @relation(fields: [targetGroupId], references: [id], onDelete: Restrict)
  feeType FeeType? @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  payments Payment[]
  @@unique([seasonId, studentId])
  @@map("season_enrollments")
}

enum RenewalDecision {
  UNDECIDED
  CONTACT
  CONTINUING
  LEFT
}

model Prospect {
  id String @id @default(cuid())
  firstName String
  lastName String
  birthDate DateTime?
  contactName String
  contactPhone String
  branchId String
  groupId String?
  notes String @default("")
  stage ProspectStage @default(NEW)
  convertedStudentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  convertedStudent Student? @relation(fields: [convertedStudentId], references: [id], onDelete: Restrict)
  visits TrialVisit[]
  activities ProspectActivity[]
  @@index([branchId, stage])
  @@map("prospects")
}
model TrialVisit {
  id String @id @default(cuid())
  prospectId String
  sessionId String
  result TrialResult @default(INVITED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@unique([prospectId,sessionId])
  @@map("trial_visits")
}
model ProspectActivity {
  id String @id @default(cuid())
  prospectId String
  actorId String
  message String
  createdAt DateTime @default(now())
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  @@index([prospectId,createdAt])
  @@map("prospect_activities")
}
enum ProspectStage {
  NEW
  INVITED
  ATTENDED
  CONVERTED
  LOST
}
enum TrialResult {
  INVITED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model AttentionPolicy {
  id String @id @default(cuid())
  branchId String @unique
  windowDays Int @default(30)
  absenceCount Int @default(3)
  overdueDays Int @default(7)
  endingDays Int @default(30)
  updatedAt DateTime @updatedAt
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@map("attention_policies")
}
model FollowUp {
  id String @id @default(cuid())
  studentId String
  reason AttentionReason
  assignedToId String?
  nextContactAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  activities FollowUpActivity[]
  @@unique([studentId,reason])
  @@map("follow_ups")
}
model FollowUpActivity {
  id String @id @default(cuid())
  followUpId String
  actorId String
  note String
  createdAt DateTime @default(now())
  followUp FollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([followUpId,createdAt])
  @@map("follow_up_activities")
}
enum AttentionReason {
  ABSENCE
  OVERDUE
  SEASON
}
